{
  "name": "minesweeper",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "A quiet game of logic. Minesweeper rebuilt with native TypeScript 7.",
  "engines": { "node": "^22.12.0 || >=24.0.0" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "compile": "tsc -p tsconfig.app.json",
    "build": "npm run compile && vite build",
    "preview": "vite preview",
    "test": "tsc -p tsconfig.test.json && node --test .native/tests/tests/*.test.js",
    "check": "npm run typecheck && npm test && npm run build",
    "bench:types": "node scripts/bench-types.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "7.0.2",
    "vite": "^8.2.2"
  }
}
